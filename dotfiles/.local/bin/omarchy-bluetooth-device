#!/bin/bash

# omarchy:summary=Control a Bluetooth device or power state
# omarchy:group=bluetooth
# omarchy:args=[pair|connect|disconnect|forget|on|off|toggle] [address]
# omarchy:examples=omarchy bluetooth device connect 00:11:22:33:44:55

set -e

usage() {
  echo "Usage: omarchy-bluetooth-device [pair|connect|disconnect|forget|on|off|toggle] [address]" >&2
  exit 1
}

action=${1:-}
address=${2:-}

power_on() {
  rfkill unblock bluetooth >/dev/null 2>&1 || true
  bluetoothctl power on >/dev/null 2>&1 || true
  sleep 0.5
}

power_off() {
  bluetoothctl power off >/dev/null 2>&1 || true
}

power_toggle() {
  if bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
    power_off
  else
    power_on
  fi
}

trust_device() {
  bluetoothctl trust "$address" >/dev/null 2>&1 || true
}

case "$action" in
  on | power-on)
    power_on
    ;;
  off | power-off)
    power_off
    ;;
  toggle | power-toggle)
    power_toggle
    ;;
  pair)
    [[ $address =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || usage
    power_on
    timeout 20s bluetoothctl pair "$address" >/dev/null 2>&1 || true
    trust_device
    timeout 20s bluetoothctl connect "$address" >/dev/null 2>&1 || true
    ;;
  connect)
    [[ $address =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || usage
    power_on
    trust_device
    timeout 20s bluetoothctl connect "$address" >/dev/null 2>&1 || true
    ;;
  disconnect)
    [[ $address =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || usage
    timeout 10s bluetoothctl disconnect "$address" >/dev/null 2>&1 || true
    ;;
  forget)
    [[ $address =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || usage
    power_on
    timeout 10s bluetoothctl disconnect "$address" >/dev/null 2>&1 || true
    timeout 10s bluetoothctl remove "$address" >/dev/null 2>&1 || true
    ;;
  *)
    usage
    ;;
esac
