#!/bin/bash

# omarchy:summary=Print the most likely display backlight device.
# omarchy:examples=omarchy-hw-display

if [[ -d /sys/class/backlight/acpi_video1 ]]; then
  echo "acpi_video1"
  exit 0
fi

if [[ -d /sys/class/backlight/intel_backlight ]]; then
  echo "intel_backlight"
  exit 0
fi

if [[ -d /sys/class/backlight/amdgpu_bl0 ]]; then
  echo "amdgpu_bl0"
  exit 0
fi

for dev in /sys/class/backlight/*; do
  [[ -e "$dev" ]] || continue
  basename "$dev"
  exit 0
done

exit 1
