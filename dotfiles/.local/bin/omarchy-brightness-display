#!/bin/bash

# omarchy:summary=Show or adjust brightness on the focused display.
# omarchy:args=[--no-osd] [--monitor name] [+N%|N%-|N%|off|on]

no_osd=0
monitor=""

while (( $# > 0 )); do
  case "$1" in
  --no-osd)
    no_osd=1
    shift
    ;;
  --monitor)
    (( $# >= 2 )) || exit 1
    monitor="$2"
    shift 2
    ;;
  *)
    break
    ;;
  esac
done

get_device() {
  if [[ -d /sys/class/backlight/acpi_video1 ]]; then
    echo "acpi_video1"
  elif [[ -d /sys/class/backlight/intel_backlight ]]; then
    echo "intel_backlight"
  elif [[ -d /sys/class/backlight/amdgpu_bl0 ]]; then
    echo "amdgpu_bl0"
  else
    for dev in /sys/class/backlight/*; do
      if [[ -d "$dev" ]]; then
        basename "$dev"
        return 0
      fi
    done
    echo "acpi_video0"
  fi
}

device=$(get_device)

get_current() {
  if [[ -f "/sys/class/backlight/$device/brightness" && -f "/sys/class/backlight/$device/max_brightness" ]]; then
    local cur max
    read -r cur < "/sys/class/backlight/$device/brightness"
    read -r max < "/sys/class/backlight/$device/max_brightness"
    if (( max > 0 )); then
      echo $(( cur * 100 / max ))
      return 0
    fi
  fi
  brightnessctl -d "$device" -m 2>/dev/null | awk -F, '{ gsub("%", "", $4); print $4; exit }'
}

if (( $# == 0 )); then
  get_current
  exit 0
fi

step="$1"

if [[ $step == "off" ]]; then
  hyprctl dispatch 'hl.dsp.dpms({ action = "disable" })' >/dev/null 2>&1
  exit 0
elif [[ $step == "on" ]]; then
  hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })' >/dev/null 2>&1
  exit 0
fi

current=$(get_current)
target=$current

if [[ $step =~ ^\+[0-9]+%?$ ]]; then
  delta=${step#+}
  delta=${delta%%%}
  if (( current < 5 && delta == 5 )); then
    (( target = current + 1 ))
  else
    (( target = current + delta ))
  fi
  (( target > 100 )) && target=100
  step="$target%"
elif [[ $step =~ ^[0-9]+%?-$ ]]; then
  delta=${step%-}
  delta=${delta%%%}
  if (( current <= 5 && delta == 5 )); then
    (( target = current - 1 ))
  else
    (( target = current - delta ))
  fi
  (( target < 1 )) && target=1
  step="$target%"
fi

# Set brightness directly on the active backlight device
brightnessctl -d "$device" set "$step" >/dev/null 2>&1

# Show OSD asynchronously without blocking key repeats
if (( ! no_osd )); then
  new_cur=$(get_current)
  omarchy-osd -i brightness -p "$new_cur" >/dev/null 2>&1 &
fi
